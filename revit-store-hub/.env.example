# ==============================================================================
# REVIT STORE HUB - BIẾN MÔI TRƯỜNG & KHÓA KẾT NỐI (ENVIRONMENT VARIABLES)
# ==============================================================================

# 1. CƠ SỞ DỮ LIỆU & AUTHENTICATION (SUPABASE)
# Lấy tại: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key

# 2. LƯU TRỮ FILE RIÊNG TƯ (CLOUDFLARE R2)
# Lấy tại: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=revit-vault-private
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 3. CỔNG THANH TOÁN TỰ ĐỘNG VIETQR (PAYOS)
# Lấy tại: https://payos.vn/ -> Quản lý Kênh thanh toán
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# 4. CẤU HÌNH BẢN QUYỀN REVIT ADD-IN
LICENSE_SECRET_SALT=REVIT_HUB_SECRET_SALT_2026
